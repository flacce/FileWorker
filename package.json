{
  "name": "file-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "pnpm run build && wrangler pages dev ./dist --r2=BUCKET",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/ functions/",
    "deploy": "pnpm run build && wrangler pages deploy ./dist"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@unocss/reset": "^66.8.1",
    "codemirror": "^6.0.2",
    "cookie": "^2.0.1",
    "hono": "^4.13.5",
    "marked": "^18.0.11",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "toastify-js": "^1.12.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@iconify-json/mdi": "^1.2.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.4.0",
    "@types/toastify-js": "^1.12.4",
    "@unocss/transformer-directives": "^66.8.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "unocss": "^66.8.1",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.127.0"
  }
}

{
  "name": "file-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "pnpm run build && wrangler dev --port 8788",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force && node node_modules/typescript7/bin/tsc -p tsconfig.app-ts.json && node node_modules/typescript7/bin/tsc -p functions/tsconfig.json",
    "lint": "eslint . --fix",
    "format": "prettier --write src/ functions/",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@unocss/reset": "^66.13.0",
    "codemirror": "^6.0.2",
    "hono": "5.0.0-rc.1",
    "marked": "^18.2.0",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "toastify-js": "^1.12.0",
    "vue": "3.6.0-rc.15",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@iconify-json/mdi": "^1.2.3",
    "@tsconfig/node26": "26.0.2",
    "@types/node": "^26.6.6",
    "@types/toastify-js": "^1.12.4",
    "@unocss/transformer-directives": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/compiler-sfc": "3.6.0-rc.15",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.1.0-dev.20261115.1",
    "unocss": "^66.13.0",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.162.0"
  }
}

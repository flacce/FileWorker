{
  "name": "paste-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "pnpm run build && wrangler pages dev ./dist",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "deploy": "pnpm run build && wrangler pages deploy ./dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.954.0",
    "@aws-sdk/lib-storage": "^3.954.0",
    "@aws-sdk/s3-request-presigner": "^3.954.0",
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.4",
    "@types/toastify-js": "^1.12.3",
    "@unocss/reset": "^0.65.1",
    "@xmldom/xmldom": "^0.8.11",
    "aws4fetch": "^1.0.20",
    "axios": "^1.7.9",
    "codemirror": "^6.0.1",
    "cookie": "^0.6.0",
    "fast-xml-parser": "^5.3.3",
    "js-cookie": "^3.0.5",
    "mime": "^4.0.5",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "latest",
    "toastify-js": "^1.12.0",
    "vue": "^3.6.0-alpha.7",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@iconify-json/mdi": "^1.2.1",

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fileworker",
  "main": "functions/[[path]].ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "fff",
      "preview_bucket_name": "fff"
    }
  ]
}
